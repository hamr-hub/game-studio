<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="168dp"
    android:layout_margin="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <FrameLayout
            android:id="@+id/game_icon_container"
            android:layout_width="@dimen/game_icon_size"
            android:layout_height="@dimen/game_icon_size"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_game_icon_surface"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/game_icon_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/game_cover_mark_iv"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_game_cover_mark" />

            <TextView
                android:id="@+id/game_icon_tv"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/space_sm"
                android:background="@drawable/bg_game_label_badge"
                android:gravity="center"
                android:textColor="@color/text_on_brand"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </FrameLayout>

        <TextView
            android:id="@+id/game_name_tv"
            style="@style/TextAppearance.GameStudio.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/game_size_tv"
            style="@style/TextAppearance.GameStudio.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
