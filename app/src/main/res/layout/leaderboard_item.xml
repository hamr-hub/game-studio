<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="@dimen/space_sm"
    android:background="@drawable/bg_card_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/card_padding"
    android:paddingEnd="@dimen/card_padding">

    <TextView
        android:id="@+id/leaderboard_rank_tv"
        android:layout_width="44dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_rank_chip"
        android:gravity="center"
        android:textColor="@color/brand_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/leaderboard_icon_tv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/space_md"
        android:gravity="center"
        android:textColor="@color/text_on_brand"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/leaderboard_title_tv"
            style="@style/TextAppearance.GameStudio.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/leaderboard_meta_tv"
            style="@style/TextAppearance.GameStudio.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/leaderboard_score_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_primary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
